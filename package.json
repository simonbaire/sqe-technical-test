{
  "name": "sqe-technical-test",
  "version": "1.0.0",
  "private": true,
  "description": "API (Swagger Petstore) and UI (Sauce Demo) test automation for the SQE technical test",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui:headless": "playwright test --project=ui",
    "test:ui:headed": "playwright test --project=ui --headed",
    "test:ui:chrome": "playwright test --config=playwright.chrome.config.ts",
    "test:api:api-mode": "playwright test --project=api --ui",
    "test:web:ui-mode": "playwright test --project=ui --ui",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.47.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
